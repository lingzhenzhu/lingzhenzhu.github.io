{
  "name": "lingzhen-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lzzhu/site dev",
    "dev:admin": "pnpm --filter @lzzhu/studio dev",
    "preview": "node scripts/preview.mjs",
    "build": "pnpm build:assets && pnpm --filter @lzzhu/site build && pnpm --filter @lzzhu/studio build",
    "build:assets": "tsx scripts/build-assets.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm build",
    "db:local": "node scripts/tool.mjs wrangler d1 migrations apply website-content --local --config apps/studio/wrangler.jsonc",
    "seed:local": "tsx scripts/seed-local.ts",
    "release:prepare": "tsx scripts/release.ts prepare",
    "release:report": "tsx scripts/release.ts report",
    "audit:output": "tsx scripts/audit-output.ts",
    "audit:performance": "node scripts/audit-performance.mjs",
    "backend:check": "tsx scripts/preflight.ts",
    "deploy:studio": "tsx scripts/deploy-studio.ts",
    "backend:probe": "tsx scripts/backend-probe.ts",
    "backup:rehearse": "node scripts/restore-rehearsal.mjs",
    "migration:export": "tsx scripts/export-legacy-rewards.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@dnd-kit/react": "0.5.1",
    "@lzzhu/content": "workspace:*",
    "@lzzhu/presentation": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "astro": "7.4.2",
    "fast-xml-parser": "5.11.2",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "cheerio": "1.2.0",
    "esbuild": "0.28.2",
    "fontkit": "2.0.4",
    "lighthouse": "13.5.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "subset-font": "2.9.0",
    "tar": "7.5.22",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
