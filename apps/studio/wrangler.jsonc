{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lzzhu-website-studio",
  "main": "server/index.tsx",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "images": { "binding": "IMAGES" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "www.lzzhu.net/admin*", "zone_name": "lzzhu.net" },
    { "pattern": "www.lzzhu.net/api/*", "zone_name": "lzzhu.net" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://www.lzzhu.net",
    "ACCESS_ISSUER": "https://lzzhu.cloudflareaccess.com",
    "ACCESS_AUD": "d39166553187530ef64f449dc99774fb2385eb98451329ed5c213f0f2c4f7b6f",
    "REWARDS_ACCESS_AUD": "",
    "REWARDS_EMAILS": "",
    "FIREBASE_CARD_ENABLED": "1",
    "FIREBASE_PROJECT_ID": "card-84e16",
    "FIREBASE_DATABASE_URL": "https://card-84e16-default-rtdb.asia-southeast1.firebasedatabase.app",
    "FIREBASE_ADMIN_EMAIL": "admin@lzzhu.net",
    "FIREBASE_ADMIN_UID": "yBTVxrrCgQTXNVKlB95yV1LlX6U2",
    "ADMIN_EMAILS": "admin@lzzhu.net",
    "BUILD_SERVICE_ID": "fb23048735c8de1880b14803f5f8b33b.access",
    "GITHUB_REPOSITORY": "lingzhenzhu/lingzhenzhu.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-content",
      "database_id": "e6859c9a-ee46-4121-b9e3-3b1338c47a6a",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PRIVATE", "bucket_name": "lzzhu-website-private" }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
